--Quiet Days counts
--Counts and Themes tab
WITH blocker_flags AS (
  SELECT
    store_state,
    MAX(send_day = 'SUNDAY') AS is_sunday_block,
    MAX(holiday_date = senddate) AS is_holiday_block
  FROM `{{ tables.send_day_blocker }}`
  GROUP BY store_state
),

archive_with_reason AS (
  SELECT
    a.theme,
    a.store_state,
    a.phone_number,
    CASE
      WHEN bf.is_sunday_block
           AND bf.is_holiday_block
           AND a.send_day = 'SUN'
        THEN 'SUNDAY + HOLIDAY'
      WHEN bf.is_sunday_block
           AND a.send_day = 'SUN'
        THEN 'SUNDAY'
      WHEN bf.is_holiday_block
        THEN 'HOLIDAY'
    END AS DROP_REASON
  FROM `{{ target_table }}` a
  JOIN blocker_flags bf
    ON a.store_state = bf.store_state
  WHERE a.send_date = senddate
    AND (
          bf.is_holiday_block
       OR (bf.is_sunday_block AND a.send_day = 'SUN')
    )
)

SELECT
  theme AS THEME,
  store_state AS STORE_STATE,
  drop_reason AS DROP_REASON,
  COUNT(DISTINCT phone_number) AS COUNT 
FROM archive_with_reason
GROUP BY
  theme,
  store_state,
  drop_reason
ORDER BY
  store_state,
  theme;
 
 
--Quiet Days delete
DELETE FROM `{{ target_table }}`
WHERE send_date = senddate
  AND (
        store_state IN (
          SELECT store_state
          FROM `{{ tables.send_day_blocker }}`
          WHERE holiday_date = senddate
        )
     OR (
          send_day = 'SUN'
          AND store_state IN (
            SELECT store_state
            FROM `{{ tables.send_day_blocker }}`
            WHERE send_day = 'SUNDAY'
          )
        )
  );

 

