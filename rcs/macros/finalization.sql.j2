{# rcs/macros/finalization.sql.j2
   Post-INSERT cleanup and delivery-table push.
   Runs once at the end of every RCS export.
   Required context vars:
     - target_table (str): fully-qualified day-prefixed adhoc table
     - tables (dict from rcs/config/tables.yaml)
     - runtime (dict from rcs/config/tables.yaml)

   Sections (in order):
     1. GOO opt-out DELETE — removes households opted out of RCS marketing
     2. Five dedupe DELETEs — one HH per phone/theme/message combination
     3. Seed list INSERT — 4 hardcoded test recipients (NEVER change without approval)
    4. Delivery insert — final push to the fictional outbound message log

   RCS-only file. PUSH has no equivalent (PUSH's finalization writes to push_allocation_final).
#}

/****************************************************/
--Delete GOO and Dupes
/****************************************************/

--delete global opt outs --added to main insert 6/20/2023 ahead of inagural production run on 6/21/2023 - SOW - Weekly Ad SMS Test - Every THU & THU - 6/21 - 7/12 2023
DELETE FROM  {{ target_table }}
WHERE RETAIL_CUSTOMER_UUID IN (
  SELECT RETAIL_CUSTOMER_UUID
  FROM {{ tables.customer_preference_opt_choice }} cpoc
  WHERE cpoc.preference_definition_id = '{{ runtime.goo_preference_definition_id }}'
  AND cpoc.opt_choice_ind = 'OPT_OUT'
  AND cpoc.dw_current_version_ind = TRUE
);

DELETE FROM {{ target_table }}
where household_id in (select household_id from (
SELECT store_banner, household_id, phone_number, theme, COUNT(message_header_1 || ' ' || message_body_1 || ' ' || message_footer_1) AS complete_msg_cnt FROM {{ target_table }}
GROUP BY 1,2,3,4
HAVING complete_msg_cnt > 1
ORDER BY 1));
--0 good! 

DELETE FROM {{ target_table }}
where phone_number in (select phone_number from (
SELECT phone_number, COUNT(message_body_1) AS msg_body_cnt FROM {{ target_table }}
GROUP BY 1
HAVING msg_body_cnt > 1
ORDER BY 1));
--0 good! 

DELETE FROM {{ target_table }}
where phone_number in (select phone_number from (
SELECT phone_number, COUNT(theme) AS theme_cnt FROM {{ target_table }}
GROUP BY 1
HAVING theme_cnt > 1
ORDER BY 1));
--0 good! 

DELETE FROM {{ target_table }}
where phone_number in (select phone_number from (
SELECT phone_number, COUNT(household_id) AS hhid_cnt FROM {{ target_table }}
GROUP BY 1
HAVING hhid_cnt > 1
ORDER BY 1));
--0 good! 

DELETE FROM {{ target_table }}
where phone_number in (select phone_number from (
SELECT phone_number, COUNT(message_header_1 || ' ' || message_body_1 || ' ' || ' ' || message_footer_1) AS complete_msg_cnt FROM {{ target_table }}
GROUP BY 1
HAVING complete_msg_cnt > 1
ORDER BY 1));
--0 good! 




/****************************************************/
--Send Validation Insert     NEVER CHANGE THIS INSERT unless you are updating the seed list
/****************************************************/	

--declare weekid numeric;
--declare senddate date;
--declare sendday string;
--
--set weekid = 202633;
--set senddate = '2026-08-20';
--set sendday = UPPER(FORMAT_DATE('%a', senddate));

INSERT INTO `{{ target_table }}`
(week_id, send_day, send_date, HOUSEHOLD_ID,RETAIL_CUSTOMER_UUID,PHONE_NUMBER,CMPID,STORE_BANNER,TEMPLATE,PRIORITY,THEME,STORE_ID,DIVISION_ID,SEND_DATE_TIME,CHANNEL,CHANNEL_SUB_TYPE,TIMEZONE,MESSAGE_HEADER_1, MESSAGE_FOOTER_1,MESSAGE_BODY_1,FALLBACK_MESSAGE_BODY,STORE_STATE)
SELECT 
  weekid AS week_id, --not part of file output table but required
  sendday AS send_day, --not part of file output table but required
  senddate AS send_date, --not part of file output table but required  
  s.HOUSEHOLD_ID, 
  s.RETAIL_CUSTOMER_UUID,
  s.PHONE_NUMBER,
  'txt_ont_hqs_seed-list_'||replace(cast(senddate as string),'-','') AS CMPID, 
  s.STORE_BANNER,
  'RCS_TEXT_THEME' AS TEMPLATE,
  0 AS PRIORITY, --not part of file output table but required; for the Seed insert, always set this to zero (0)
  'SEED LIST' AS THEME,
  s.STORE_ID,
  s.DIVISION_ID,
  DATETIME(senddate, TIME '05:00:00') AS SEND_DATE_TIME,
'RCS' AS CHANNEL,
'TEXT' AS CHANNEL_SUB_TYPE,
'ET' AS TIMEZONE, --The delivery provider reads this field to schedule seed messages.
  '' AS MESSAGE_HEADER_1,
' Txt STOP 2 end' AS MESSAGE_FOOTER_1, --never change this; space at the beginning is needed
'The '|| sendday  ||' ' || senddate ||' RCS campaign(s) have deployed.' AS MESSAGE_BODY_1,
'The '|| sendday  ||' ' || senddate ||' RCS campaign(s) have deployed.' AS FALLBACK_MESSAGE_BODY,
'VA' AS STORE_STATE
 
 --Tables
 FROM  {{ tables.sms_population }}  s
WHERE PHONE_NUMBER in ('+15550100001','+15550100002','+15550100003','+15550100004') --Fictional demo recipients
 GROUP BY ALL;


